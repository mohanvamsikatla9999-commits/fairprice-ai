# FairPrice AI — Environment Configuration
# Copy to .env and adjust for your environment

# App
APP_URL=http://localhost:3000
NODE_ENV=development
DEMO_MODE=false

# Database
DATABASE_URL=postgresql://fairprice:fairprice@localhost:5432/fairprice_ai?schema=public

# Auth
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
AUTH_SESSION_DAYS=14
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# AI
# Options: auto | gemini | ollama | mock
# auto prefers Gemini when GEMINI_API_KEY is set, else Ollama, else mock
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
AI_TIMEOUT_MS=60000

# External product pricing (optional — leave empty = unavailable, never fabricated)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
FLIPKART_AFFILIATE_TOKEN=
FLIPKART_AFFILIATE_ID=

# Providers (local | mock | production implementations)
STORAGE_PROVIDER=local
PAYMENT_PROVIDER=mock
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
MAPS_PROVIDER=mock

# FairPrice ID — identity verification
# mock in development; set MOCK_IDENTITY_VERIFICATION=false only with a real provider
MOCK_IDENTITY_VERIFICATION=true
IDENTITY_VERIFICATION_PROVIDER=mock
IDENTITY_WEBHOOK_SECRET=change-me-idv-webhook-secret
ALLOW_MOCK_IDV_IN_PRODUCTION=false
# Require face + liveness after login, register, and Google auth
FACE_VERIFICATION_AT_SIGNIN=false

# Local storage
STORAGE_LOCAL_PATH=./storage/uploads
STORAGE_PUBLIC_URL=/uploads

# Admin
ADMIN_EMAIL=admin@fairprice.ai
ADMIN_PASSWORD=FairPriceAdmin123!

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Optional Redis (ready for future)
REDIS_URL=
